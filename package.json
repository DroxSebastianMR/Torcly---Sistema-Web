{
  "name": "torcly",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names WEB,API --prefix-colors cyan,green \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @torcly/web dev",
    "dev:api": "pnpm --filter @torcly/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @torcly/api db:generate",
    "db:validate": "pnpm --filter @torcly/api db:validate",
    "db:check": "pnpm --filter @torcly/api db:check",
    "db:smoke:products": "pnpm --filter @torcly/api db:smoke:products",
    "db:pull": "pnpm --filter @torcly/api db:pull",
    "db:migrate:dev": "pnpm --filter @torcly/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @torcly/api db:migrate:deploy",
    "db:studio": "pnpm --filter @torcly/api db:studio",
    "format": "prettier --write apps docs package.json pnpm-workspace.yaml README.md",
    "format:check": "prettier --check apps docs package.json pnpm-workspace.yaml README.md",
    "start:api": "pnpm --filter @torcly/api start"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "prettier": "3.6.2"
  }
}
