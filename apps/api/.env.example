NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pool transaccional de Supabase para consultas de la aplicación.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require

# Pool de sesión de Supabase para Prisma Migrate, db pull y Prisma Studio.
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Dashboard y reportes realizan varias lecturas independientes en paralelo.
DATABASE_POOL_SIZE=8
DATABASE_CONNECT_TIMEOUT_MS=10000
# Conserva conexiones reutilizables al cambiar de módulo; reduce reconexiones TLS al pool remoto.
DATABASE_IDLE_TIMEOUT_MS=120000

# Seguridad de autenticación.
SESSION_COOKIE_NAME=torcly_session
# En producción con frontend/API en dominios separados, usar `none` y HTTPS.
SESSION_COOKIE_SAME_SITE=lax
SESSION_IDLE_MINUTES=30
# Cierra la sesión tras inactividad; limita la jornada total aunque haya actividad.
SESSION_ABSOLUTE_HOURS=8
# Reduce lecturas/escrituras remotas de sesión sin debilitar la expiración del servidor.
SESSION_ACTIVITY_REFRESH_MINUTES=5
# La autorización se mantiene en memoria por un intervalo corto; la expiración absoluta e inactividad se validan siempre.
SESSION_AUTH_CACHE_SECONDS=120
# Renueva el identificador de sesión durante jornadas largas sin cerrar al usuario.
SESSION_TOKEN_RENEWAL_HOURS=4
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Asistente IA (solo API; nunca usar prefijo VITE_ ni copiar al cliente).
# Pega aquí tu clave de Groq; nunca la expongas como VITE_ ni la subas a Git.
# Dejar GROQ_API_KEY vacío deshabilita el asistente de forma segura.
GROQ_API_KEY=
AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
AI_REQUEST_TIMEOUT_MS=12000
AI_RATE_LIMIT_PER_MINUTE=8
AI_MAX_OUTPUT_TOKENS=350
# AI_PROVIDER=fake permite pruebas locales sin una llamada externa.

# Credenciales requeridas únicamente por `pnpm db:seed`.
SEED_ADMIN_EMAIL=admin@torcly.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrador Torcly
SEED_ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_SEGURA
# En producción se crea además el dueño del taller. Ambos reciben el rol Administrador.
SEED_OWNER_EMAIL=dueno@torcly.local
SEED_OWNER_USERNAME=dueno
SEED_OWNER_NAME=Dueño del taller
SEED_OWNER_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_SEGURA
