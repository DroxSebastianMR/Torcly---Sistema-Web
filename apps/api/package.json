    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/cors": "2.8.19",
    "@types/node": "22.20.3",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "eslint": "10.10.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.70.0",
    "globals": "17.12.0"
  }
