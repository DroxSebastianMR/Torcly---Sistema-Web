generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum InventoryMovementType {
  INITIAL
  ENTRY
  EXIT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum InventoryMovementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CustomerType {
  NATURAL
  LEGAL
}

enum SaleStatus {
  DRAFT
  CONFIRMED
}

enum SaleLineType {
  PRODUCT
  SERVICE
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  SESSION_EXPIRED
  ACCESS_DENIED
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  USER_ACTIVATED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  VEHICLE_CREATED
  VEHICLE_UPDATED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DEACTIVATED
  PRODUCT_ACTIVATED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DEACTIVATED
  SERVICE_ACTIVATED
  INVENTORY_STOCK_INITIALIZED
  INVENTORY_ENTRY_REGISTERED
  INVENTORY_EXIT_REGISTERED
  INVENTORY_ADJUSTMENT_REGISTERED
  SALE_CREATED
  SALE_CONFIRMED
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  username            String        @unique @db.VarChar(50)
  email               String        @unique @db.VarChar(254)
  displayName         String        @map("display_name") @db.VarChar(120)
  passwordHash        String        @map("password_hash") @db.VarChar(255)
  active              Boolean       @default(true)
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until") @db.Timestamptz(3)
  roles               UserRole[]
  sessions            AuthSession[]
  auditLogs           AuditLog[]
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(80)
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(180)
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuthSession {
  tokenHash      String    @id @map("token_hash") @db.Char(64)
  userId         String    @map("user_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress      String?   @map("ip_address") @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(300)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id        String         @id @default(uuid()) @db.Uuid
  event     AuditEventType
  userId    String?        @map("user_id") @db.Uuid
  identifier String?       @db.VarChar(254)
  requestId String?        @map("request_id") @db.VarChar(80)
  ipAddress String?        @map("ip_address") @db.VarChar(64)
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@map("audit_logs")
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  type           CustomerType
  documentNumber String       @unique @map("document_number") @db.VarChar(11)
  firstName      String?      @map("first_name") @db.VarChar(80)
  lastName       String?      @map("last_name") @db.VarChar(80)
  legalName      String?      @map("legal_name") @db.VarChar(160)
  phone          String       @db.VarChar(20)
  email          String?      @db.VarChar(254)
  vehicles       Vehicle[]
  sales          Sale[]
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([type])
  @@index([lastName])
  @@index([legalName])
  @@index([phone])
  @@map("customers")
}

model Vehicle {
  id         String   @id @default(uuid()) @db.Uuid
  plate      String   @unique @db.VarChar(12)
  brand      String   @db.VarChar(80)
  model      String   @db.VarChar(120)
  year       Int      @map("year")
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([customerId])
  @@index([brand])
  @@map("vehicles")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_categories")
}

model ProductBrand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_brands")
}

model ProductUnit {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(60)
  symbol    String    @unique @db.VarChar(12)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_units")
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique @db.VarChar(40)
  barcode            String?             @unique @db.VarChar(32)
  name               String              @db.VarChar(120)
  description        String?             @db.VarChar(500)
  salePrice          Decimal             @map("sale_price") @db.Decimal(12, 2)
  minimumStock       Decimal             @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  active             Boolean             @default(true)
  categoryId         String              @map("category_id") @db.Uuid
  brandId            String?             @map("brand_id") @db.Uuid
  unitId             String              @map("unit_id") @db.Uuid
  category           ProductCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand              ProductBrand?       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit               ProductUnit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]
  saleLines          SaleLine[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([active])
  @@map("products")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  price       Decimal  @map("price") @db.Decimal(12, 2)
  active      Boolean  @default(true)
  saleLines   SaleLine[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@index([active])
  @@map("services")
}

model InventoryMovement {
  id             String                  @id @default(uuid()) @db.Uuid
  productId      String                  @map("product_id") @db.Uuid
  type           InventoryMovementType
  status         InventoryMovementStatus @default(PENDING)
  quantity       Decimal                 @db.Decimal(12, 3)
  referenceType  String?                 @map("reference_type") @db.VarChar(40)
  referenceId    String?                 @map("reference_id") @db.VarChar(80)
  idempotencyKey String?                 @unique @map("idempotency_key") @db.VarChar(100)
  notes          String?                 @db.VarChar(300)
  performedBy    String                  @map("performed_by") @db.VarChar(80)
  occurredAt     DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, status, occurredAt])
  @@map("inventory_movements")
}

model Sale {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(20)
  customerId  String?      @map("customer_id") @db.Uuid
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status      SaleStatus   @default(DRAFT)
  subtotal    Decimal      @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)
  performedBy String       @map("performed_by") @db.VarChar(80)
  confirmedBy String?      @map("confirmed_by") @db.VarChar(80)
  confirmedAt DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  lines       SaleLine[]
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([customerId])
  @@index([status, createdAt])
  @@map("sales")
}

model SaleLine {
  id        String       @id @default(uuid()) @db.Uuid
  saleId    String       @map("sale_id") @db.Uuid
  sale      Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type      SaleLineType
  productId String?      @map("product_id") @db.Uuid
  serviceId String?      @map("service_id") @db.Uuid
  product   Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  service   Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  name      String       @db.VarChar(120)
  code      String       @db.VarChar(40)
  unitLabel String?      @map("unit_label") @db.VarChar(20)
  unitPrice Decimal      @map("unit_price") @db.Decimal(12, 2)
  quantity  Decimal      @db.Decimal(12, 3)
  subtotal  Decimal      @db.Decimal(12, 2)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([saleId])
  @@index([productId])
  @@index([serviceId])
  @@map("sale_lines")
}
