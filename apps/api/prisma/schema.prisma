generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum InventoryMovementType {
  INITIAL
  ENTRY
  EXIT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum InventoryMovementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CustomerType {
  NATURAL
  LEGAL
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SaleLineType {
  PRODUCT
  SERVICE
}

enum AppointmentStatus {
  PROGRAMADA
  CANCELADA
  ATENDIDA
}

enum WorkOrderSource {
  APPOINTMENT
  WALK_IN
}

enum WorkOrderStatus {
  RECEPCIONADA
  EN_DIAGNOSTICO
  PENDIENTE_APROBACION
  APROBADA
  RECHAZADA
  EN_EJECUCION
  LISTA_PARA_ENTREGA
  ENTREGADA
}

enum WorkOrderLineType {
  PRODUCT
  SERVICE
}

enum WorkOrderActivityStatus {
  PENDIENTE
  COMPLETADA
}

enum WorkOrderConsumptionType {
  CONSUMPTION
  RETURN
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  DIGITAL_WALLET
}

enum PaymentType {
  PAYMENT
  COMPENSATION
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  SESSION_EXPIRED
  ACCESS_DENIED
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  USER_ACTIVATED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  VEHICLE_CREATED
  VEHICLE_UPDATED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DEACTIVATED
  PRODUCT_ACTIVATED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DEACTIVATED
  SERVICE_ACTIVATED
  TECHNICIAN_CREATED
  TECHNICIAN_UPDATED
  TECHNICIAN_DEACTIVATED
  TECHNICIAN_ACTIVATED
  INVENTORY_STOCK_INITIALIZED
  INVENTORY_ENTRY_REGISTERED
  INVENTORY_EXIT_REGISTERED
  INVENTORY_ADJUSTMENT_REGISTERED
  SALE_CREATED
  SALE_CONFIRMED
  SALE_CANCELLED
  APPOINTMENT_CREATED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_ATTENDED
  WORK_ORDER_CREATED
  WORK_ORDER_DIAGNOSIS_UPDATED
  WORK_ORDER_BUDGET_SAVED
  WORK_ORDER_BUDGET_SENT
  WORK_ORDER_BUDGET_APPROVED
  WORK_ORDER_BUDGET_REJECTED
  WORK_ORDER_TECHNICIAN_ASSIGNED
  WORK_ORDER_EXECUTION_STARTED
  WORK_ORDER_ACTIVITY_CREATED
  WORK_ORDER_ACTIVITY_COMPLETED
  WORK_ORDER_PRODUCT_CONSUMED
  WORK_ORDER_PRODUCT_RETURNED
  WORK_ORDER_READY_FOR_DELIVERY
  WORK_ORDER_DELIVERED
  PAYMENT_REGISTERED
  PAYMENT_COMPENSATED
  CASH_SESSION_OPENED
  CASH_SESSION_CLOSED
  REPLENISHMENT_RUN_EXECUTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  MAINTENANCE_SCHEDULED
  MAINTENANCE_CANCELLED
  SUPPLIER_CREATED
  SUPPLIER_UPDATED
  SUPPLIER_DEACTIVATED
  SUPPLIER_ACTIVATED
  PURCHASE_CREATED
  PURCHASE_UPDATED
  PURCHASE_CONFIRMED
  PURCHASE_CANCELLED
  PURCHASE_LINE_ADDED
  PURCHASE_LINE_UPDATED
  PURCHASE_LINE_DELETED
  PROFILE_UPDATED
  PASSWORD_CHANGED
  NOTIFICATION_READ
  ALL_NOTIFICATIONS_READ
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model User {
  id                       String                  @id @default(uuid()) @db.Uuid
  username                 String                  @unique @db.VarChar(50)
  email                    String                  @unique @db.VarChar(254)
  displayName              String                  @map("display_name") @db.VarChar(120)
  passwordHash             String                  @map("password_hash") @db.VarChar(255)
  active                   Boolean                 @default(true)
  isPlatformAdmin          Boolean                 @default(false) @map("is_platform_admin")
  failedLoginAttempts      Int                     @default(0) @map("failed_login_attempts")
  lockedUntil              DateTime?               @map("locked_until") @db.Timestamptz(3)
  mustChangePassword       Boolean                 @default(false) @map("must_change_password")
  roles                    UserRole[]
  sessions                 AuthSession[]
  auditLogs                AuditLog[]
  legacyAssignedWorkOrders WorkOrder[]             @relation("WorkOrderTechnician")
  replenishmentRuns        ReplenishmentRun[]
  passwordResetTokens      PasswordResetToken[]
  notificationPreferences  Json?                   @map("notification_preferences")
  notifications            Notification[]
  announcementReads        AnnouncementRead[]
  assistantConversations   AssistantConversation[]
  organizationMemberships  OrganizationMembership[]
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active])
  @@index([isPlatformAdmin])
  @@map("users")
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  code        String                   @unique @db.VarChar(40)
  name        String                   @db.VarChar(160)
  active      Boolean                  @default(true)
  memberships OrganizationMembership[]
  sessions    AuthSession[]            @relation("ActiveOrganizationSession")
  customers   Customer[]
  vehicles    Vehicle[]
  productCategories ProductCategory[]
  productBrands ProductBrand[]
  productUnits ProductUnit[]
  products    Product[]
  services    Service[]
  technicians Technician[]
  appointments Appointment[]
  workOrders  WorkOrder[]
  inventoryMovements InventoryMovement[]
  sales       Sale[]
  payments    Payment[]
  cashSessions CashSession[]
  replenishmentRuns ReplenishmentRun[]
  suppliers   Supplier[]
  purchases   Purchase[]
  assistantConversations AssistantConversation[]
  notifications Notification[]
  subscription  OrganizationSubscription?
  auditLogs   AuditLog[]
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active, name])
  @@map("organizations")
}

model OrganizationMembership {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  active         Boolean      @default(true)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([organizationId, userId])
  @@index([userId, active])
  @@index([roleId])
  @@map("organization_memberships")
}

model AssistantConversation {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  title          String             @db.VarChar(120)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AssistantMessage[]

  @@index([organizationId, userId, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  role           AssistantMessageRole
  content        String                @db.VarChar(3000)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(80)
  active      Boolean          @default(true)
  users       UserRole[]
  organizationMemberships OrganizationMembership[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(180)
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuthSession {
  tokenHash      String    @id @map("token_hash") @db.Char(64)
  userId         String    @map("user_id") @db.Uuid
  activeOrganizationId String? @map("active_organization_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress      String?   @map("ip_address") @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(300)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation("ActiveOrganizationSession", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([activeOrganizationId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
    organizationId String?    @map("organization_id") @db.Uuid
  event      AuditEventType
  userId     String?        @map("user_id") @db.Uuid
  identifier String?        @db.VarChar(254)
  requestId  String?        @map("request_id") @db.VarChar(80)
  ipAddress  String?        @map("ip_address") @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
    organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
    @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model Customer {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  type           CustomerType
  documentNumber String        @map("document_number") @db.VarChar(11)
  firstName      String?       @map("first_name") @db.VarChar(80)
  lastName       String?       @map("last_name") @db.VarChar(80)
  legalName      String?       @map("legal_name") @db.VarChar(160)
  phone          String        @db.VarChar(20)
  email          String?       @db.VarChar(254)
  vehicles       Vehicle[]
  sales          Sale[]
  appointments   Appointment[]
  workOrders     WorkOrder[]
  payments       Payment[]
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, documentNumber])
  @@index([organizationId, type])
  @@index([lastName])
  @@index([legalName])
  @@index([phone])
  @@map("customers")
}

model Vehicle {
  id           String        @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  plate        String        @db.VarChar(12)
  brand        String        @db.VarChar(80)
  model        String        @db.VarChar(120)
  year         Int           @map("year")
  mileage      Int?          @map("mileage")
  customerId   String        @map("customer_id") @db.Uuid
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  workOrders   WorkOrder[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, plate])
  @@index([organizationId, customerId])
  @@index([brand])
  @@map("vehicles")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name      String    @db.VarChar(80)
  active    Boolean   @default(true)
  products  Product[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("product_categories")
}

model ProductBrand {
  id        String    @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name      String    @db.VarChar(80)
  active    Boolean   @default(true)
  products  Product[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("product_brands")
}

model ProductUnit {
  id        String    @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name      String    @db.VarChar(60)
  symbol    String    @db.VarChar(12)
  active    Boolean   @default(true)
  products  Product[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, name])
  @@unique([organizationId, symbol])
  @@index([organizationId, active])
  @@map("product_units")
}

model Product {
  id                           String                        @id @default(uuid()) @db.Uuid
  organizationId               String                        @map("organization_id") @db.Uuid
  code                         String                        @db.VarChar(40)
  barcode                      String?                       @db.VarChar(32)
  name                         String                        @db.VarChar(120)
  description                  String?                       @db.VarChar(500)
  salePrice                    Decimal                       @map("sale_price") @db.Decimal(12, 2)
  minimumStock                 Decimal                       @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  active                       Boolean                       @default(true)
  categoryId                   String                        @map("category_id") @db.Uuid
  brandId                      String?                       @map("brand_id") @db.Uuid
  unitId                       String                        @map("unit_id") @db.Uuid
  category                     ProductCategory               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                        ProductBrand?                 @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit                         ProductUnit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  organization                 Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryMovements           InventoryMovement[]
  saleLines                    SaleLine[]
  workOrderLines               WorkOrderLine[]
  workOrderConsumptions        WorkOrderConsumption[]
  replenishmentRecommendations ReplenishmentRecommendation[]
  purchaseLines                PurchaseLine[]
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, code])
  @@unique([organizationId, barcode])
  @@index([organizationId, name])
  @@index([categoryId])
  @@index([brandId])
  @@index([active])
  @@index([organizationId, active, name])
  @@map("products")
}

model Service {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  code           String          @db.VarChar(40)
  name           String          @db.VarChar(120)
  description    String?         @db.VarChar(500)
  price          Decimal         @map("price") @db.Decimal(12, 2)
  active         Boolean         @default(true)
  saleLines      SaleLine[]
  workOrderLines WorkOrderLine[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@index([active])
  @@index([organizationId, active, name])
  @@map("services")
}

model Technician {
  id          String      @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code        String      @db.VarChar(20)
  fullName    String      @map("full_name") @db.VarChar(120)
  document    String?     @db.VarChar(30)
  phone       String?     @db.VarChar(30)
  email       String?     @db.VarChar(254)
  specialties String?     @db.VarChar(500)
  notes       String?     @db.VarChar(500)
  active      Boolean     @default(true)
  createdBy   String      @map("created_by") @db.VarChar(80)
  updatedBy   String?     @map("updated_by") @db.VarChar(80)
  workOrders  WorkOrder[] @relation("WorkOrderTechnicianRecord")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, code])
  @@unique([organizationId, document])
  @@unique([organizationId, email])
  @@index([organizationId, active, fullName])
  @@map("technicians")
}

model InventoryMovement {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @map("organization_id") @db.Uuid
  productId             String                  @map("product_id") @db.Uuid
  type                  InventoryMovementType
  status                InventoryMovementStatus @default(PENDING)
  quantity              Decimal                 @db.Decimal(12, 3)
  referenceType         String?                 @map("reference_type") @db.VarChar(40)
  referenceId           String?                 @map("reference_id") @db.VarChar(80)
  idempotencyKey        String?                 @unique @map("idempotency_key") @db.VarChar(100)
  notes                 String?                 @db.VarChar(300)
  performedBy           String                  @map("performed_by") @db.VarChar(80)
  occurredAt            DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  product               Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrderConsumptions WorkOrderConsumption[]

  @@index([organizationId, productId, status, occurredAt])
  @@index([organizationId, status, occurredAt])
  @@index([productId, status, occurredAt])
  @@index([status, occurredAt])
  @@map("inventory_movements")
}

model Sale {
  id          String     @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code        String     @db.VarChar(20)
  customerId  String?    @map("customer_id") @db.Uuid
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  workOrderId String?    @unique @map("work_order_id") @db.Uuid
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status      SaleStatus @default(DRAFT)
  subtotal    Decimal    @db.Decimal(12, 2)
  total       Decimal    @db.Decimal(12, 2)
  performedBy String     @map("performed_by") @db.VarChar(80)
  confirmedBy String?    @map("confirmed_by") @db.VarChar(80)
  confirmedAt DateTime?  @map("confirmed_at") @db.Timestamptz(3)
  cancelledBy String?    @map("cancelled_by") @db.VarChar(80)
  cancelledAt DateTime?  @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String? @map("cancellation_reason") @db.VarChar(300)
  lines       SaleLine[]
  payments    Payment[]
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, code])
  @@index([organizationId, customerId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, status, confirmedAt])
  @@index([customerId])
  @@index([status, createdAt])
  @@index([status, confirmedAt])
  @@map("sales")
}

model Appointment {
  id            String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  code          String            @unique @db.VarChar(20)
  customerId    String            @map("customer_id") @db.Uuid
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicleId     String            @map("vehicle_id") @db.Uuid
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  date          DateTime          @map("date") @db.Date
  time          DateTime          @map("time") @db.Time(0)
  reason        String            @db.VarChar(300)
  status        AppointmentStatus @default(PROGRAMADA)
  performedBy   String            @map("performed_by") @db.VarChar(80)
  rescheduledBy String?           @map("rescheduled_by") @db.VarChar(80)
  rescheduledAt DateTime?         @map("rescheduled_at") @db.Timestamptz(3)
  cancelledBy   String?           @map("cancelled_by") @db.VarChar(80)
  cancelledAt   DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  attendedBy    String?           @map("attended_by") @db.VarChar(80)
  attendedAt    DateTime?         @map("attended_at") @db.Timestamptz(3)
  workOrder     WorkOrder?
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, date, time])
  @@index([organizationId, status, date, time])
  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([vehicleId])
  @@map("appointments")
}

model SaleLine {
