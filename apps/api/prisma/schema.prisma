generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum InventoryMovementType {
  INITIAL
  ENTRY
  EXIT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum InventoryMovementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CustomerType {
  NATURAL
  LEGAL
}

enum SaleStatus {
  DRAFT
  CONFIRMED
}

enum SaleLineType {
  PRODUCT
  SERVICE
}

enum AppointmentStatus {
  PROGRAMADA
  CANCELADA
  ATENDIDA
}

enum WorkOrderStatus {
  RECEPCIONADA
  EN_DIAGNOSTICO
  PENDIENTE_APROBACION
  APROBADA
  RECHAZADA
  EN_EJECUCION
  LISTA_PARA_ENTREGA
  ENTREGADA
}

enum WorkOrderLineType {
  PRODUCT
  SERVICE
}

enum WorkOrderActivityStatus {
  PENDIENTE
  COMPLETADA
}

enum WorkOrderConsumptionType {
  CONSUMPTION
  RETURN
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  DIGITAL_WALLET
}

enum PaymentType {
  PAYMENT
  COMPENSATION
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  SESSION_EXPIRED
  ACCESS_DENIED
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  USER_ACTIVATED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  VEHICLE_CREATED
  VEHICLE_UPDATED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DEACTIVATED
  PRODUCT_ACTIVATED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DEACTIVATED
  SERVICE_ACTIVATED
  INVENTORY_STOCK_INITIALIZED
  INVENTORY_ENTRY_REGISTERED
  INVENTORY_EXIT_REGISTERED
  INVENTORY_ADJUSTMENT_REGISTERED
  SALE_CREATED
  SALE_CONFIRMED
  APPOINTMENT_CREATED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_ATTENDED
  WORK_ORDER_CREATED
  WORK_ORDER_DIAGNOSIS_UPDATED
  WORK_ORDER_BUDGET_SAVED
  WORK_ORDER_BUDGET_SENT
  WORK_ORDER_BUDGET_APPROVED
  WORK_ORDER_BUDGET_REJECTED
  WORK_ORDER_TECHNICIAN_ASSIGNED
  WORK_ORDER_EXECUTION_STARTED
  WORK_ORDER_ACTIVITY_CREATED
  WORK_ORDER_ACTIVITY_COMPLETED
  WORK_ORDER_PRODUCT_CONSUMED
  WORK_ORDER_PRODUCT_RETURNED
  WORK_ORDER_READY_FOR_DELIVERY
  WORK_ORDER_DELIVERED
  PAYMENT_REGISTERED
  PAYMENT_COMPENSATED
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  username            String        @unique @db.VarChar(50)
  email               String        @unique @db.VarChar(254)
  displayName         String        @map("display_name") @db.VarChar(120)
  passwordHash        String        @map("password_hash") @db.VarChar(255)
  active              Boolean       @default(true)
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until") @db.Timestamptz(3)
  roles               UserRole[]
  sessions            AuthSession[]
  auditLogs           AuditLog[]
  assignedWorkOrders  WorkOrder[]  @relation("WorkOrderTechnician")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(80)
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(180)
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuthSession {
  tokenHash      String    @id @map("token_hash") @db.Char(64)
  userId         String    @map("user_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress      String?   @map("ip_address") @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(300)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id        String         @id @default(uuid()) @db.Uuid
  event     AuditEventType
  userId    String?        @map("user_id") @db.Uuid
  identifier String?       @db.VarChar(254)
  requestId String?        @map("request_id") @db.VarChar(80)
  ipAddress String?        @map("ip_address") @db.VarChar(64)
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@map("audit_logs")
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  type           CustomerType
  documentNumber String       @unique @map("document_number") @db.VarChar(11)
  firstName      String?      @map("first_name") @db.VarChar(80)
  lastName       String?      @map("last_name") @db.VarChar(80)
  legalName      String?      @map("legal_name") @db.VarChar(160)
  phone          String       @db.VarChar(20)
  email          String?      @db.VarChar(254)
  vehicles       Vehicle[]
  sales          Sale[]
  appointments   Appointment[]
  workOrders     WorkOrder[]
  payments       Payment[]
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([type])
  @@index([lastName])
  @@index([legalName])
  @@index([phone])
  @@map("customers")
}

model Vehicle {
  id         String   @id @default(uuid()) @db.Uuid
  plate      String   @unique @db.VarChar(12)
  brand      String   @db.VarChar(80)
  model      String   @db.VarChar(120)
  year       Int      @map("year")
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  workOrders    WorkOrder[]
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([customerId])
  @@index([brand])
  @@map("vehicles")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_categories")
}

model ProductBrand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_brands")
}

model ProductUnit {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(60)
  symbol    String    @unique @db.VarChar(12)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_units")
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique @db.VarChar(40)
  barcode            String?             @unique @db.VarChar(32)
  name               String              @db.VarChar(120)
  description        String?             @db.VarChar(500)
  salePrice          Decimal             @map("sale_price") @db.Decimal(12, 2)
  minimumStock       Decimal             @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  active             Boolean             @default(true)
  categoryId         String              @map("category_id") @db.Uuid
  brandId            String?             @map("brand_id") @db.Uuid
  unitId             String              @map("unit_id") @db.Uuid
  category           ProductCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand              ProductBrand?       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit               ProductUnit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]
  saleLines          SaleLine[]
  workOrderLines     WorkOrderLine[]
  workOrderConsumptions WorkOrderConsumption[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([active])
  @@map("products")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  price       Decimal  @map("price") @db.Decimal(12, 2)
  active      Boolean  @default(true)
  saleLines   SaleLine[]
  workOrderLines WorkOrderLine[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@index([active])
  @@map("services")
}

model InventoryMovement {
  id             String                  @id @default(uuid()) @db.Uuid
  productId      String                  @map("product_id") @db.Uuid
  type           InventoryMovementType
  status         InventoryMovementStatus @default(PENDING)
  quantity       Decimal                 @db.Decimal(12, 3)
  referenceType  String?                 @map("reference_type") @db.VarChar(40)
  referenceId    String?                 @map("reference_id") @db.VarChar(80)
  idempotencyKey String?                 @unique @map("idempotency_key") @db.VarChar(100)
  notes          String?                 @db.VarChar(300)
  performedBy    String                  @map("performed_by") @db.VarChar(80)
  occurredAt     DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  workOrderConsumptions WorkOrderConsumption[]

  @@index([productId, status, occurredAt])
  @@map("inventory_movements")
}

model Sale {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(20)
  customerId  String?      @map("customer_id") @db.Uuid
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status      SaleStatus   @default(DRAFT)
  subtotal    Decimal      @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)
  performedBy String       @map("performed_by") @db.VarChar(80)
  confirmedBy String?      @map("confirmed_by") @db.VarChar(80)
  confirmedAt DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  lines       SaleLine[]
  payments    Payment[]
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([customerId])
  @@index([status, createdAt])
  @@map("sales")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  code           String            @unique @db.VarChar(20)
  customerId     String            @map("customer_id") @db.Uuid
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId      String            @map("vehicle_id") @db.Uuid
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  date           DateTime          @map("date") @db.Date
  time           DateTime          @map("time") @db.Time(0)
  reason         String            @db.VarChar(300)
  status         AppointmentStatus @default(PROGRAMADA)
  performedBy    String            @map("performed_by") @db.VarChar(80)
  rescheduledBy  String?           @map("rescheduled_by") @db.VarChar(80)
  rescheduledAt  DateTime?         @map("rescheduled_at") @db.Timestamptz(3)
  cancelledBy    String?           @map("cancelled_by") @db.VarChar(80)
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  attendedBy     String?           @map("attended_by") @db.VarChar(80)
  attendedAt     DateTime?         @map("attended_at") @db.Timestamptz(3)
  workOrder      WorkOrder?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([date, time])
  @@index([status, date, time])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([vehicleId])
  @@map("appointments")
}

model SaleLine {
  id        String       @id @default(uuid()) @db.Uuid
  saleId    String       @map("sale_id") @db.Uuid
  sale      Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type      SaleLineType
  productId String?      @map("product_id") @db.Uuid
  serviceId String?      @map("service_id") @db.Uuid
  product   Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  service   Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  name      String       @db.VarChar(120)
  code      String       @db.VarChar(40)
  unitLabel String?      @map("unit_label") @db.VarChar(20)
  unitPrice Decimal      @map("unit_price") @db.Decimal(12, 2)
  quantity  Decimal      @db.Decimal(12, 3)
  subtotal  Decimal      @db.Decimal(12, 2)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([saleId])
  @@index([productId])
  @@index([serviceId])
  @@map("sale_lines")
}

model WorkOrder {
  id                      String          @id @default(uuid()) @db.Uuid
  code                    String          @unique @db.VarChar(20)
  appointmentId           String          @unique @map("appointment_id") @db.Uuid
  appointment             Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  customerId              String          @map("customer_id") @db.Uuid
  customer                Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId               String          @map("vehicle_id") @db.Uuid
  vehicle                 Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  status                  WorkOrderStatus @default(RECEPCIONADA)
  technicianId            String?         @map("technician_id") @db.Uuid
  technician              User?           @relation(fields: [technicianId], references: [id], onDelete: SetNull, name: "WorkOrderTechnician")
  diagnosis               String?         @db.VarChar(1000)
  diagnosisUpdatedBy      String?         @map("diagnosis_updated_by") @db.VarChar(80)
  diagnosisUpdatedAt      DateTime?       @map("diagnosis_updated_at") @db.Timestamptz(3)
  budgetSentBy            String?         @map("budget_sent_by") @db.VarChar(80)
  budgetSentAt            DateTime?       @map("budget_sent_at") @db.Timestamptz(3)
  approvedBy              String?         @map("approved_by") @db.VarChar(80)
  approvedAt              DateTime?       @map("approved_at") @db.Timestamptz(3)
  rejectedBy              String?         @map("rejected_by") @db.VarChar(80)
  rejectedAt              DateTime?       @map("rejected_at") @db.Timestamptz(3)
  decisionNotes           String?         @map("decision_notes") @db.VarChar(500)
  executionStartedBy      String?         @map("execution_started_by") @db.VarChar(80)
  executionStartedAt      DateTime?       @map("execution_started_at") @db.Timestamptz(3)
  readyForDeliveryAt      DateTime?       @map("ready_for_delivery_at") @db.Timestamptz(3)
  deliveredBy             String?         @map("delivered_by") @db.VarChar(80)
  deliveredAt             DateTime?       @map("delivered_at") @db.Timestamptz(3)
  deliveryNotes           String?         @map("delivery_notes") @db.VarChar(500)
  subtotal                Decimal         @default(0) @db.Decimal(12, 2)
  total                   Decimal         @default(0) @db.Decimal(12, 2)
  performedBy             String          @map("performed_by") @db.VarChar(80)
  lines                   WorkOrderLine[]
  activities              WorkOrderActivity[]
  consumptions            WorkOrderConsumption[]
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([appointmentId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status, createdAt])
  @@index([technicianId])
  @@index([createdAt])
  @@map("work_orders")
}

model WorkOrderLine {
  id          String           @id @default(uuid()) @db.Uuid
  workOrderId String           @map("work_order_id") @db.Uuid
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  type        WorkOrderLineType
  productId   String?          @map("product_id") @db.Uuid
  serviceId   String?          @map("service_id") @db.Uuid
  product     Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  service     Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  name        String           @db.VarChar(120)
  code        String           @db.VarChar(40)
  unitLabel   String?          @map("unit_label") @db.VarChar(20)
  unitPrice   Decimal          @map("unit_price") @db.Decimal(12, 2)
  quantity    Decimal          @db.Decimal(12, 3)
  subtotal    Decimal          @db.Decimal(12, 2)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  consumptions WorkOrderConsumption[]

  @@index([workOrderId])
  @@index([productId])
  @@index([serviceId])
  @@map("work_order_lines")
}

model WorkOrderActivity {
  id          String                @id @default(uuid()) @db.Uuid
  workOrderId String                @map("work_order_id") @db.Uuid
  workOrder   WorkOrder             @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  description String                @db.VarChar(500)
  occurredAt  DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)
  performedBy String                @map("performed_by") @db.VarChar(80)
  status      WorkOrderActivityStatus @default(PENDIENTE)
  completedBy String?               @map("completed_by") @db.VarChar(80)
  completedAt DateTime?             @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([workOrderId, status])
  @@map("work_order_activities")
}

model WorkOrderConsumption {
  id              String               @id @default(uuid()) @db.Uuid
  workOrderId     String               @map("work_order_id") @db.Uuid
  workOrder       WorkOrder            @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderLineId String               @map("work_order_line_id") @db.Uuid
  workOrderLine   WorkOrderLine        @relation(fields: [workOrderLineId], references: [id], onDelete: Restrict)
  productId       String               @map("product_id") @db.Uuid
  product         Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  type            WorkOrderConsumptionType
  quantity        Decimal              @db.Decimal(12, 3)
  idempotencyKey  String               @unique @map("idempotency_key") @db.VarChar(100)
  movementId      String?              @map("movement_id") @db.Uuid
  inventoryMovement InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  notes           String?              @db.VarChar(300)
  performedBy     String               @map("performed_by") @db.VarChar(80)
  occurredAt      DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workOrderId, workOrderLineId])
  @@index([workOrderId, type])
  @@index([productId])
  @@map("work_order_consumptions")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  code              String          @unique @db.VarChar(20)
  saleId            String          @map("sale_id") @db.Uuid
  sale              Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customerId        String?         @map("customer_id") @db.Uuid
  customer          Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type              PaymentType     @default(PAYMENT)
  originalPaymentId String?         @map("original_payment_id") @db.Uuid
  originalPayment   Payment?        @relation("PaymentCompensation", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  compensations     Payment[]       @relation("PaymentCompensation")
  amount            Decimal         @db.Decimal(12, 2)
  method            PaymentMethod
  idempotencyKey    String          @unique @map("idempotency_key") @db.VarChar(100)
  notes             String?         @db.VarChar(300)
  reason            String?         @db.VarChar(300)
  performedBy       String          @map("performed_by") @db.VarChar(80)
  occurredAt        DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([saleId, occurredAt])
  @@index([saleId, method])
  @@index([customerId])
  @@index([method, occurredAt])
  @@map("payments")
}
